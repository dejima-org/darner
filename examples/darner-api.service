[Unit]
Description=darner API
After=network-online.target
Wants=network-online.target

[Service]
User=darner
Group=darner
ExecStart=/opt/darner/venv/bin/darner-api --config /etc/darner/api.toml
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/darner
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
