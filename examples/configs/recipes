# A recurring task on a self-hosted model, with the context and access it
# always needs. A request names it with `config: recipes` and adds only what
# changes, such as `allow:` for the recipe's website.
ctx: myapp
harness: cline
backend: self-hosted
model: qwen3-14b
internal: recipes.example.com:8443
# Gives each session configs_dir/files/recipes-token in ~/shared/uploads.
file: recipes-token
