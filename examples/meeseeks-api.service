[Unit]
Description=meeseeks API
After=network-online.target
Wants=network-online.target

[Service]
User=meeseeks
Group=meeseeks
ExecStart=/opt/meeseeks/venv/bin/meeseeks-api --config /etc/meeseeks/api.toml
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/meeseeks
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
