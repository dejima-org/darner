#
# darner-web, the browser frontend. Its config is mounted at /etc/darner/web.toml;
# see examples/compose.yaml and docs/web.md. It stores nothing, so it has no
# state directory.
#
# By digest, as the API's Dockerfile, so the base can't change unreviewed.
FROM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159

RUN groupadd --system --gid 10001 darner \
    && useradd --system --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin darner

# Pinned with hashes, as the API's; see requirements/web.in.
COPY requirements/web.txt /src/requirements/web.txt
RUN pip install --no-cache-dir --require-hashes -r /src/requirements/web.txt
COPY pyproject.toml LICENSE /src/
COPY darner /src/darner
RUN pip install --no-cache-dir --no-deps --no-build-isolation /src

USER darner
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
EXPOSE 8081
ENTRYPOINT ["darner-web"]
# 0.0.0.0 inside the container only; compose publishes it on the host's loopback.
CMD ["--config", "/etc/darner/web.toml", "--listen", "0.0.0.0:8081"]
